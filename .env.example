# Copy this file to .env before running Docker Compose.
POSTGRES_DB=familygram
POSTGRES_USER=familygram
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=5432

MINIO_ROOT_USER=familygram
MINIO_ROOT_PASSWORD=replace-with-another-long-random-password
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=familygram

APP_URL=http://localhost:3000
APP_PORT=3000
HEALTH_ALLOWED_ORIGIN=
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
